# Convex (Required for full functionality)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Gemini AI (Required for AI features - get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Clerk Authentication (for production use)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key
# CLERK_SECRET_KEY=sk_test_your-key

# Optional: Analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
